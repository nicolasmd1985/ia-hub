### Create `app/models/subsidiary.rb`

This file will define the `Subsidiary` model.

```ruby
# app/models/subsidiary.rb
class Subsidiary < ApplicationRecord
  has_many :users, dependent: :destroy
  has_many :orders, dependent: :destroy
  has_many :things, dependent: :destroy
  has_many :categories, dependent: :destroy
  has_many :components, dependent: :destroy
  has_many :order_rates, dependent: :destroy
  has_many :tools, dependent: :destroy
  belongs_to :status, optional: true
  belongs_to :corporation, optional: true

  callback :set_subsidiary_initials, before: :save

  def set_subsidiary_initials
    if name.present? && name.length >= 3
      if name.length == 3
        self.initials = name.upcase
      elsif name.length == 2
        self.initials = name.first
      else
        words = name.split(" ")
        self.initials = words.first(3).collect(&:capitalize).join("")
      end
    end
  end

  def subsidiary_name
    return name if name.present?
    return corporation.name if corporation.present?
    name
  end
end
```

### Create `app/graphql/inputs/subsidiary_input.rb`

This file will define the GraphQL input for creating a Subsidiary.

```ruby
# app/graphql/inputs/subsidiary_input.rb
InputType SubsidiaryInput = InputType.new(
  name: StringInputType,
  phone: StringInputType,
  address: StringInputType,
  email: StringInputType,
  status: StatusInputType,
  corporation: CorporationInputType
)
```

### Create `spec/factories/subsidiaries.rb`

This file will define factories for creating Subsidiary instances.

```ruby
# spec/factories/subsidiaries.rb
FactoryBot.define do
  factory :subsidiary do
    name { Faker::Name.name }
    phone { Faker::PhoneNumber.phone_number }
    address { Faker::Address.street_address }
    email { Faker::Internet.email }
    status { create(:status) }
    corporation { create(:corporation) }
    set_subsidiary_initials
  end
end
```

### Create `spec/models/subsidiary_spec.rb`

This file will define specs for the `Subsidiary` model.

```ruby
# spec/models/subsidiary_spec.rb
require 'rails_helper'

RSpec.describe Subsidiary, type: :model do
  describe "associations" do
    it { is_expected.to have_many(:users).dependent(:destroy) }
    it { is_expected.to have_many(:orders).dependent(:destroy) }
    it { is_expected.to have_many(:things).dependent(:destroy) }
    it { is_expected.to have_many(:categories).dependent(:destroy) }
    it { is_expected.to have_many(:components).dependent(:destroy) }
    it { is_expected.to have_many(:order_rates).dependent(:destroy) }
    it { is_expected.to have_many(:tools).dependent(:destroy) }
    it { is_expected.to belong_to(:status).optional }
    it { is_expected.to belong_to(:corporation).optional }
  end

  describe "callbacks" do
    it "sets initials" do
      subject.initials = "XYZ"
      expect(subject.initials).to eq("XYZ")
    end

    it "sets initials for short names" do
      subject.name = "Bob"
      expect(subject.initials).to eq("B")
    end

    it "sets initials for single-word names" do
      subject.name = "Alice"
      expect(subject.initials).to eq("AL")
    end
  end

  describe "subsidiary_name" do
    it "returns the name if available" do
      expect(subject.subsidiary_name).to eq(subject.name)
    end

    it "returns the corporation name if the name is nil" do
      subject.name = nil
      expect(subject.subsidiary_name).to eq(subject.corporation.name)
    end
  end
end
```

### Create `spec/graphql/mutations/subsidiaries/create_subsidiary_spec.rb`

This file will define specs for the Subsidiary mutation in GraphQL.

```ruby
# spec/graphql/mutations/subsidiaries/create_subsidiary_spec.rb
require 'rails_helper'

RSpec.describe 'Subsidiaries Create mutation', type: :request do
  let!(:user) { create(:user, :admin) }
  let!(:corporation) { create(:corporation) }
  let!(:status) { create(:status) }
  let!(:factory) { create(:subsidiary) }

  context "admin user can create a Subsidiary successfully" do
    it "succeeds and returns the created Subsidiary" do
      result = JSON.parse(post_graphql("/graphql", variables: { input: { name: "Example Subsidiary", phone: "123-456-7890", address: "123 Example St", email: "example@example.com", status: status.id, corporation: corporation.id }.to_json }, query: 'mutation { createSubsidiary(input: $input) { subsidiary { id, name, phone, address, email, status, corporation, subsidiaryName }} }').body)
      expect(result.dig('data', 'createSubsidiary', 'subsidiary', 'id')).to be_present
      expect(result.dig('data', 'createSubsidiary', 'subsidiary', 'name')).to eq(factory.name)
      expect(result.dig('data', 'createSubsidiary', 'subsidiary', 'phone')).to eq(factory.phone)
      expect(result.dig('data', 'createSubsidiary', 'subsidiary', 'address')).to eq(factory.address)
      expect(result.dig('data', 'createSubsidiary', 'subsidiary', 'email')).to eq(factory.email)
      expect(result.dig('data', 'createSubsidiary', 'subsidiary', 'status')).to eq(factory.status.name)
      expect(result.dig('data', 'createSubsidiary', 'subsidiary', 'corporation')).to eq(factory.corporation.name)
      expect(result.dig('data', 'createSubsidiary', 'subsidiary', 'subsidiaryName')).to eq(factory.subsidiary_name)
    end
  end

  context "non-admin user gets Unauthorized error" do
    it "fails with an unauthorized error" do
      result = JSON.parse(post_graphql("/graphql", variables: { input: { name: "Example Subsidiary", phone: "123-456-7890", address: "123 Example St", email: "example@example.com", status: status.id, corporation: corporation.id }.to_json }, query: 'mutation { createSubsidiary(input: $input) { subsidiary { id, name, phone, address, email, status, corporation, subsidiaryName }} }').body)
      expect(result.dig('errors')).to be_present
      expect(result.dig('errors', 0, 'message')).to eq("Unauthorized")
    end
  end

  context "missing required fields return validation errors" do
    it "fails with validation errors" do
      result = JSON.parse(post_graphql("/graphql", variables: { input: { status: status.id, corporation: corporation.id }.to_json }, query: 'mutation { createSubsidiary(input: $input) { subsidiary { id, name, phone, address, email, status, corporation, subsidiaryName }} }').body)
      expect(result.dig('errors')).to be_present
      expect(result.dig('errors', 0, 'message')).to eq("can't be blank")
      expect(result.dig('errors', 1, 'message')).to eq("can't be blank")
    end
  end
end
```

