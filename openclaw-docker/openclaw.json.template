{
  "gateway": {
    "mode": "local",
    "port": 18789,
    "bind": "lan",
    "controlUi": {
      "allowedOrigins": [
        "http://localhost:18789",
        "http://100.101.253.100:18789"
      ],
      "dangerouslyDisableDeviceAuth": true,
      "allowInsecureAuth": true
    }
  },
  "agents": {
    "defaults": {
      "timeoutSeconds": 86450,
      "bootstrapMaxChars": 12000,
      "model": "ollama/qwen2.5-coder:3b",
      "llm": {
        "idleTimeoutSeconds": 86450
      },
      "models": {
        "ollama/qwen2.5-coder:3b": {
          "alias": "Qwen 2.5 Coder 3B",
          "streaming": true
        },
        "ollama/qwen2.5:1.5b": {
          "alias": "Qwen 2.5 1.5B (Routing)",
          "streaming": true
        },
        "ollama/llama3.2:3b": {
          "alias": "Llama 3.2 3B (QA)",
          "streaming": true
        },
        "ollama/gemma2:2b": {
          "alias": "Gemma 2 2B (Product Owner)",
          "streaming": true
        }
      }
    },
    "list": [
      {
        "id": "product_owner",
        "default": true,
        "name": "Product Owner",
        "workspace": "/root/.openclaw/workspaces/product_owner",
        "model": "ollama/gemma2:2b-vram",
        "identity": { "name": "Product Owner", "emoji": "📋", "theme": "Agile requirements specialist" },
        "tools": { "profile": "coding" }
      },
      {
        "id": "architect",
        "name": "Architect",
        "workspace": "/root/.openclaw/workspaces/architect",
        "model": "ollama/qwen2.5:1.5b-cpu",
        "identity": { "name": "Architect", "emoji": "🏗️", "theme": "task routing orchestrator" },
        "tools": { "profile": "minimal" }
      },
      {
        "id": "backend",
        "name": "Backend Developer",
        "workspace": "/root/.openclaw/workspaces/backend",
        "model": "ollama/qwen2.5-coder:3b-cpu",
        "identity": { "name": "Backend", "emoji": "⚙️", "theme": "Ruby on Rails backend specialist" },
        "tools": { "profile": "coding", "deny": ["apply_patch", "image", "image_generate"] }
      },
      {
        "id": "frontend",
        "name": "Frontend Developer",
        "workspace": "/root/.openclaw/workspaces/frontend",
        "model": "ollama/qwen2.5-coder:3b-cpu",
        "identity": { "name": "Frontend", "emoji": "🎨", "theme": "Hotwire and Turbo frontend specialist" },
        "tools": { "profile": "coding", "deny": ["apply_patch", "image", "image_generate"] }
      },
      {
        "id": "analyst",
        "name": "Analyst",
        "workspace": "/root/.openclaw/workspaces/analyst",
        "model": "ollama/qwen2.5:1.5b-cpu",
        "identity": { "name": "Analyst", "emoji": "🔍", "theme": "software architecture analyst" },
        "tools": { "profile": "minimal" }
      },
      {
        "id": "qa",
        "name": "QA Engineer",
        "workspace": "/root/.openclaw/workspaces/qa",
        "model": "ollama/llama3.2:3b-cpu",
        "identity": { "name": "QA", "emoji": "🧪", "theme": "Quality assurance and testing specialist" },
        "tools": { "profile": "coding", "deny": ["apply_patch", "image", "image_generate", "read", "write", "search"] }
      }
    ]
  },
  "cron": {
    "enabled": true,
    "maxConcurrentRuns": 1,
    "sessionRetention": "1h"
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "dmPolicy": "pairing",
      "groupPolicy": "allowlist",
      "streaming": "partial"
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "ollama": {
        "baseUrl": "http://ollama-brain:11434/v1",
        "apiKey": "ollama",
        "api": "openai-completions",
        "models": [
          {
            "id": "qwen2.5-coder:3b-cpu",
            "name": "Qwen 2.5 Coder 3B (CPU-ONLY)",
            "reasoning": true,
            "input": ["text"],
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
            "contextWindow": 24576,
            "maxTokens": 4096
          },
          {
            "id": "qwen2.5:1.5b-cpu",
            "name": "Qwen2.5 1.5B (CPU-ONLY)",
            "reasoning": false,
            "input": ["text"],
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
            "contextWindow": 32768,
            "maxTokens": 2048
          },
          {
            "id": "llama3.2:3b-cpu",
            "name": "Llama 3.2 3B (CPU-ONLY)",
            "reasoning": false,
            "input": ["text"],
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
            "contextWindow": 16384,
            "maxTokens": 4096
          },
          {
            "id": "gemma2:2b-vram",
            "name": "Gemma 2 2B (VRAM-OPTIMIZED)",
            "reasoning": false,
            "input": ["text"],
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
            "contextWindow": 2048,
            "maxTokens": 1024
          },
          {
            "id": "gemma2:2b",
            "name": "Gemma 2 2B (Product Owner)",
            "reasoning": false,
            "input": ["text"],
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
            "contextWindow": 8192,
            "maxTokens": 4096
          }
        ]
      }
    }
  }
}
