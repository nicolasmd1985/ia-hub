{
  "gateway": {
    "mode": "local",
    "port": 18789,
    "bind": "lan",
    "controlUi": {
      "allowedOrigins": [
        "http://localhost:18789",
        "http://100.101.253.100:18789"
      ],
      "dangerouslyDisableDeviceAuth": true,
      "allowInsecureAuth": true
    }
  },
  "agents": {
    "defaults": {
      "timeoutSeconds": 86400,
      "model": {
        "primary": "ollama/qwen2.5:7b",
        "fallbacks": []
      },
      "models": {
        "ollama/qwen2.5:7b": {
          "alias": "Qwen 7B (Endurance Mode)",
          "streaming": false
        },
        "ollama/qwen2.5:3b": {
          "streaming": false
        }
      }
    },
    "list": [
      {
        "id": "architect",
        "default": true,
        "name": "Architect",
        "workspace": "/root/.openclaw/workspaces/architect",
        "model": {
          "primary": "ollama/qwen2.5:7b",
          "fallbacks": []
        },
        "identity": { "name": "Architect", "emoji": "🏗️", "theme": "task routing orchestrator" },
        "tools": { "profile": "minimal" }
      },
      {
        "id": "backend",
        "name": "Backend Developer",
        "workspace": "/root/.openclaw/workspaces/backend",
        "model": {
          "primary": "ollama/qwen2.5:7b",
          "fallbacks": []
        },
        "identity": { "name": "Backend", "emoji": "⚙️", "theme": "Ruby on Rails backend specialist" },
        "tools": { "profile": "coding", "deny": ["apply_patch", "image", "image_generate"] }
      },
      {
        "id": "frontend",
        "name": "Frontend Developer",
        "workspace": "/root/.openclaw/workspaces/frontend",
        "model": {
          "primary": "ollama/qwen2.5:7b",
          "fallbacks": []
        },
        "identity": { "name": "Frontend", "emoji": "🎨", "theme": "Hotwire and Turbo frontend specialist" },
        "tools": { "profile": "coding", "deny": ["apply_patch", "image", "image_generate"] }
      },
      {
        "id": "analyst",
        "name": "Analyst",
        "workspace": "/root/.openclaw/workspaces/analyst",
        "model": {
          "primary": "ollama/qwen2.5:7b",
          "fallbacks": []
        },
        "identity": { "name": "Analyst", "emoji": "🔍", "theme": "software architecture analyst" },
        "tools": { "profile": "minimal" }
      },
      {
        "id": "qa",
        "name": "QA Engineer",
        "workspace": "/root/.openclaw/workspaces/qa",
        "model": {
          "primary": "ollama/qwen2.5:7b",
          "fallbacks": []
        },
        "identity": { "name": "QA", "emoji": "🧪", "theme": "Quality assurance and testing specialist" },
        "tools": { "profile": "coding", "deny": ["apply_patch", "image", "image_generate"] }
      }
    ]
  },
  "cron": {
    "enabled": true,
    "maxConcurrentRuns": 1,
    "sessionRetention": "1h"
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "dmPolicy": "pairing",
      "groupPolicy": "allowlist",
      "streaming": "partial"
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "ollama": {
        "baseUrl": "http://ollama-brain:11434/v1",
        "apiKey": "ollama",
        "api": "openai-completions",
        "models": [
          {
            "id": "qwen2.5:7b",
            "name": "Qwen2.5 7B — Endurance Mode",
            "reasoning": false,
            "input": ["text"],
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
            "contextWindow": 32768,
            "maxTokens": 8192
          },
          {
            "id": "qwen2.5:1.5b",
            "name": "Qwen2.5 1.5B (Fallback)",
            "reasoning": false,
            "input": ["text"],
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
            "contextWindow": 16384,
            "maxTokens": 4096
          }
        ]
      }
    }
  }
}
